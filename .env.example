NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Puertos expuestos por Docker Compose. `pnpm dev` usa 3001/5180.
API_PORT=3300
APP_PORT=5176
APP_ORIGIN=http://localhost:5176
API_ORIGIN=http://localhost:3300
COOKIE_SECURE=false
# Confianza en cabeceras X-Forwarded-* para obtener la IP del cliente. Vacío usa
# el default seguro por entorno: en producción 1 salto (nginx delante), en
# desarrollo no se confía. Acepta un número de saltos ("1") o una allowlist
# IP/CIDR ("10.0.0.0/8,127.0.0.1"). NUNCA "true" si la API queda expuesta
# directamente: permitiría falsear la IP y evadir el rate-limit por IP.
TRUSTED_PROXY=
VITE_API_URL=http://localhost:3300
DATABASE_URL=postgresql://dracing:dracing@localhost:55432/dracing
SESSION_SECRET=replace-with-at-least-32-random-characters
# Credenciales OAuth de Google (Google Cloud Console → APIs y servicios → Credenciales).
# Con Docker Compose el backend usa 3300; registra ESTA URI de redirección
# en Google. Para `pnpm dev`, reemplázala temporalmente por el puerto 3001.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3300/v1/auth/google/callback
# El contenedor de producción crea este administrador solo si aún no existe.
# Define ambas variables juntas; la contraseña debe tener entre 12 y 128 caracteres.
ADMIN_DISPLAY_NAME=Administrador Taller Mono Pistón
ADMIN_EMAIL=
ADMIN_PASSWORD=
POSTGRES_DB=dracing
POSTGRES_USER=dracing
POSTGRES_PASSWORD=dracing
POSTGRES_PORT=55432
# Pasarela de pago Flow (https://www.flow.cl/docs/api.html). Por defecto apunta
# al sandbox. Obtén apiKey/secretKey en tu panel de Flow. El secretKey NUNCA
# debe exponerse al frontend. Para que el webhook sea alcanzable en desarrollo
# usa un túnel (p. ej. ngrok) y define FLOW_CONFIRM_URL/FLOW_RETURN_URL.
FLOW_API_BASE=https://sandbox.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_CONFIRM_URL=
FLOW_RETURN_URL=

# Medios (Cloudinary). CLOUDINARY_API_SECRET solo debe existir en el backend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dracing-pro

# Coordinación por WhatsApp. Aún no hay proveedor integrado: con vacío o 'noop'
# las notificaciones solo se registran en el log. Cuando se integre Twilio /
# WhatsApp Business API, se selecciona aquí (p. ej. WHATSAPP_PROVIDER=twilio) y
# se agregan sus credenciales.
WHATSAPP_PROVIDER=
